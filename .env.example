# ---------------------------------------------------------------------------
# Public site configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (required)
# Local defaults are printed by `npx supabase start`.
# Never expose the service-role key to the browser or commit real secrets.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (public; safe in the browser). Older projects call it the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only needed for older local files:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stale-attempt sweep (optional, server only)
# The sweep route also accepts a signed-in teacher/admin session. Set this only
# for manual or external scheduler calls to GET /api/assessments/sweep.
# Never prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Google Sheets reporting (Phase 4)
# The admin page /teacher/reporting controls sync on/off, mock mode and the tab.
# GOOGLE_SHEETS_MOCK_MODE=true forces mock mode locally (no Google calls).
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_MOCK_MODE=true
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private key with literal \n line breaks, wrapped in quotes.
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Results

# ---------------------------------------------------------------------------
# Assessment importer (server only; the numeric limit is passed to the form)
# Files upload directly to private Storage with signed URLs. This value is the
# per-file limit enforced by the routes and extraction. The bucket backstop is
# 50 MiB.
# ---------------------------------------------------------------------------
ASSESSMENT_IMPORT_MAX_BYTES=52428800

# ---------------------------------------------------------------------------
# Optional OpenRouter assistance (server only)
# Off unless ASSESSMENT_IMPORT_AI_ENABLED=true AND OPENROUTER_API_KEY is set.
# The deterministic parser always works without these. Never prefix the key
# with NEXT_PUBLIC_. The key is never logged or sent to the browser.
# ---------------------------------------------------------------------------
ASSESSMENT_IMPORT_AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_REQUESTS_PER_IMPORT=3
OPENROUTER_MAX_OUTPUT_TOKENS=12000
OPENROUTER_TIMEOUT_MS=30000
